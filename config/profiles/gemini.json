{
    "name": "Google Gemini",
    "description": "Google Gemini API with cloud execution",
    "path": {
        "public_tests": "tests_public",
        "private_tests": "tests_secret",
        "problem_description": "problem_description.txt",
        "source_file": "main.cpp",
        "input_folder": "in",
        "output_folder": "out",
        "error_folder": "error",
        "expected_output_folder": "expected",
        "system_path": "/config/prompts/system.txt",
        "user_task_path": "/config/prompts/user_task.txt",
        "error_fix_path": "/config/prompts/error_fix.txt"
    },
    "model": {
        "provider": "gemini",
        "base_url": "https://generativelanguage.googleapis.com",
        "model": "gemini-2.0-flash",
        "api_key": ""
    },
    "parameters": {
        "timeout": 30,
        "stream": false,
        "think": false
    },
    "environment": {
        "compiler": "g++",
        "language": "c++",
        "flags": "O3 Wall Wshadow Wextra Werror",
        "platform": "Linux x86-64"
    }
}
