{
  "active_profile": "default",
  "profiles_dir": "src/config/profiles",
  "defaults": {
    "path": {
      "public_tests": "tests_public",
      "private_tests": "tests_secret",
      "problem_description": "problem_description.txt",
      "source_file": "main.cpp",
      "input_folder": "in",
      "output_folder": "out",
      "error_folder": "error",
      "expected_output_folder": "expected",
      "system_path": "src/config/prompts/system.txt",
      "user_task_path": "src/config/prompts/user_task.txt",
      "error_fix_path": "src/config/prompts/error_fix.txt"
    },
    "parameters": {
      "stream": false,
      "think": false
    },
    "environment": {
      "compiler": "g++",
      "language": "c++",
      "flags": "O3 Wall Wshadow Wextra Werror",
      "platform": "Linux x86-64"
    }
  }
}
